{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outpost Desktop",
  "version": "0.1.0",
  "identifier": "dev.outpost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Outpost",
        "width": 1320,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "shortDescription": "Your private agent workspace",
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
